        <mxCell id="p1-n366" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" value="&lt;b&gt;Transitions&lt;/b&gt;&lt;br&gt;Chaque état déclare &lt;i&gt;transitionsPermises&lt;/i&gt; et crée l&#39;état suivant dans &lt;i&gt;gererTransition()&lt;/i&gt;. &lt;i&gt;FabriqueEtat&lt;/i&gt; recrée l&#39;état d&#39;un ticket rechargé. Voir la page 5." vertex="1">
          <mxGeometry height="125" width="245" x="340" y="842" as="geometry" />
        </mxCell>
        <mxCell id="p1-n367" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#000000;" value="&lt;b&gt;Lecture du diagramme&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;+&lt;/b&gt; public &amp;nbsp; &lt;b&gt;#&lt;/b&gt; protégé (préfixe _ utilisé par une sous-classe) &amp;nbsp; &lt;b&gt;-&lt;/b&gt; privé&lt;br&gt;&lt;b&gt;{readOnly}&lt;/b&gt; propriété Python sans setter &amp;nbsp; &lt;b&gt;/nom&lt;/b&gt; attribut dérivé&lt;br&gt;&lt;i&gt;italique&lt;/i&gt; : abstrait &amp;nbsp; &lt;u&gt;souligné&lt;/u&gt; : membre de classe &amp;nbsp; &lt;b&gt;{leaf}&lt;/b&gt; : @typing.final&lt;br&gt;&lt;br&gt;&lt;b&gt;Liens&lt;/b&gt; : ◆ composition &amp;nbsp; ◇ agrégation &amp;nbsp; → association navigable &amp;nbsp; △ généralisation&lt;br&gt;Les références sont tracées comme extrémités d&#39;association (rôle, visibilité, multiplicité). Cette page ne montre que la structure : les dépendances «create» et «use» sont à la page 3.&lt;br&gt;&lt;br&gt;&lt;b&gt;Autres vues&lt;/b&gt;&lt;br&gt;Page 2 · interface (paquet ihm, MVC) &amp;nbsp; Page 3 · instanciations&lt;br&gt;Page 4 · exceptions &amp;nbsp; Page 5 · cycle de vie du ticket (State)" vertex="1">
          <mxGeometry height="290" width="555" x="40" y="1740" as="geometry" />
        </mxCell>
