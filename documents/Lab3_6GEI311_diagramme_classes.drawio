        <mxCell id="p4-e25" edge="1" parent="1" source="p4-FabriqueEtat" style="html=1;rounded=0;endSize=10;startSize=10;fontFamily=Helvetica;fontSize=13;fontColor=#333333;jumpStyle=arc;jumpSize=10;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.2391;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;startArrow=none;strokeColor=#6B6B6B;" target="p4-ValueError" value="">
