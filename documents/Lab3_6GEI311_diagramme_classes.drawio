        <mxCell id="p5-OUVERT" parent="1" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;fontFamily=Helvetica;fontSize=15;fontColor=#333333;" value="&lt;b&gt;OUVERT&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&#39;#6B6B6B&#39; style=&#39;font-size:12px&#39;&gt;EtatOuvert&lt;/font&gt;&lt;/i&gt;" vertex="1">
