        <mxCell id="p3-n96" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" value="&lt;b&gt;Section C&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;i&gt;ControleurPrincipal&lt;/i&gt; crée les fenêtres F1 à F8 et leurs contrôleurs, &lt;i&gt;StockageImages&lt;/i&gt;, un &lt;i&gt;DepotJSON&lt;/i&gt; par lecture ou écriture, le &lt;i&gt;Ticket&lt;/i&gt; d&#39;une création (F4) et un &lt;i&gt;SystemeTickets&lt;/i&gt; vide, remplacé au démarrage par celui que rend &lt;i&gt;DepotJSON.charger()&lt;/i&gt;.&lt;br&gt;• &lt;i&gt;DepotJSON.charger()&lt;/i&gt; crée chaque &lt;i&gt;User&lt;/i&gt; ou &lt;i&gt;Admin&lt;/i&gt; selon son rôle (table &lt;i&gt;_ROLES&lt;/i&gt;) et les &lt;i&gt;Commentaire&lt;/i&gt;, puis appelle &lt;i&gt;Ticket.restaurer()&lt;/i&gt; et &lt;i&gt;FabriqueDescription&lt;/i&gt;.&lt;br&gt;• &lt;i&gt;Ticket&lt;/i&gt;, &lt;i&gt;User&lt;/i&gt;, &lt;i&gt;Admin&lt;/i&gt;, &lt;i&gt;Commentaire&lt;/i&gt; et &lt;i&gt;FabriqueDescription&lt;/i&gt; sont répétées dans cette section : ce sont les mêmes classes qu&#39;en A et B." vertex="1">
          <mxGeometry height="250" width="380" x="1500" y="1430" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
