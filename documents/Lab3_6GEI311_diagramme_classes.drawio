        <mxCell id="p5-e18" edge="1" parent="1" source="p5-ASSIGNE" style="html=1;rounded=0;endSize=10;startSize=10;fontFamily=Helvetica;fontSize=13;fontColor=#333333;jumpStyle=arc;jumpSize=10;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4444;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=open;endFill=0;startArrow=none;strokeColor=#333333;" target="p5-FERME" value="">
