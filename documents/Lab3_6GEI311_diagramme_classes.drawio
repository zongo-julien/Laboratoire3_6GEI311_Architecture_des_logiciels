        <mxCell id="p3-n33" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" value="&lt;b&gt;À retenir&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;i&gt;SessionEdition&lt;/i&gt; et &lt;i&gt;LotAdmin&lt;/i&gt; construisent leurs commandes ; le ticket n&#39;est modifié qu&#39;à &lt;i&gt;appliquer()&lt;/i&gt;.&lt;br&gt;• &lt;i&gt;SessionCreation&lt;/i&gt; hérite de &lt;i&gt;SessionEdition&lt;/i&gt; : elle crée les mêmes commandes ; son &lt;i&gt;appliquer()&lt;/i&gt; fait d&#39;abord entrer le ticket dans le dépôt.&lt;br&gt;• &lt;i&gt;appliquer()&lt;/i&gt;, défini dans &lt;i&gt;SessionOperations&lt;/i&gt;, crée le &lt;i&gt;RapportExecution&lt;/i&gt;.&lt;br&gt;• &lt;i&gt;FabriqueDescription&lt;/i&gt; est le seul endroit qui construit les sous-classes d&#39;&lt;i&gt;ElementDescription&lt;/i&gt; : &lt;i&gt;creer()&lt;/i&gt; pour un fichier, &lt;i&gt;creerSaisie()&lt;/i&gt; pour un texte tapé dans F5." vertex="1">
          <mxGeometry height="215" width="450" x="1400" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-t34" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#333333;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" value="&lt;b&gt;B.&lt;/b&gt; Ticket et états &lt;font color=&#39;#6B6B6B&#39;&gt;(patron State : chaque état construit son successeur dans gererTransition())&lt;/font&gt;" vertex="1">
          <mxGeometry height="26" width="1300" x="40" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p3-Ticket" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#6B6B6B&quot;&gt;modele&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ticket&lt;/b&gt;" vertex="1">
