          </mxGeometry>
        </mxCell>
        <mxCell id="p5-n20" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" value="&lt;b&gt;Règles du code&lt;/b&gt;&lt;br&gt;• Toute autre demande lève &lt;i&gt;TransitionInvalideException&lt;/i&gt; (comportement par défaut de &lt;i&gt;EtatTicket.gererTransition()&lt;/i&gt;) ; l&#39;Admin demande la transition &lt;b&gt;avant&lt;/b&gt; de modifier l&#39;assigné, donc un refus laisse le ticket intact.&lt;br&gt;• Désassigner remet l&#39;assigné à « aucun » ; &lt;i&gt;aDejaEteAssigne&lt;/i&gt; reste vrai.&lt;br&gt;• Fermer ou valider conserve l&#39;assigné pour la traçabilité." vertex="1">
          <mxGeometry height="132" width="790" x="900" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p5-n21" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" value="&lt;b&gt;Hors machine à états&lt;/b&gt;&lt;br&gt;&lt;i&gt;User.supprimerTicket(t)&lt;/i&gt; retire le ticket du dépôt (&lt;i&gt;SystemeTickets&lt;/i&gt;) si l&#39;utilisateur en est le créateur et que le ticket n&#39;a jamais été assigné ; le statut n&#39;est pas modifié." vertex="1">
          <mxGeometry height="84" width="790" x="900" y="552" as="geometry" />
        </mxCell>
        <mxCell id="p5-n22" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b style=&quot;&quot;&gt;Consulter sans changer d&#39;état&lt;/b&gt;&lt;br&gt;Chaque état publie &lt;i style=&quot;&quot;&gt;transitionsPermises&lt;/i&gt;, les statuts de ses flèches sortantes : OUVERT → {ASSIGNE, FERME} ; ASSIGNE → {ASSIGNE, OUVERT, VALIDATION, FERME} ; VALIDATION → {ASSIGNE, TERMINE} ; TERMINE et FERME → { } (défaut d&#39;&lt;i style=&quot;&quot;&gt;EtatTicket&lt;/i&gt;).&lt;br&gt;&lt;i style=&quot;&quot;&gt;Ticket.transitionPossible(statut)&lt;/i&gt; les consulte sans rien modifier ; l&#39;interface s&#39;en sert pour activer ses boutons : F2 « Assigner » (vers ASSIGNE), « Désassigner » (OUVERT), « Valider » (TERMINE), « Fermer » (FERME), actif si au moins un ticket sélectionné le permet ; F3 « Soumettre » (VALIDATION), pour l&#39;assigné.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="830" x="40" y="630" as="geometry" />
        </mxCell>
        <mxCell id="p5-n23" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9A9A9A;fontFamily=Helvetica;fontSize=13;fontColor=#333333;" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b style=&quot;&quot;&gt;Création et rechargement&lt;/b&gt;&lt;br&gt;Un ticket créé dans F4 naît OUVERT et n&#39;entre dans le dépôt qu&#39;à &lt;i style=&quot;&quot;&gt;SessionCreation.appliquer()&lt;/i&gt;. Un ticket rechargé par &lt;i style=&quot;&quot;&gt;DepotJSON&lt;/i&gt; reprend directement son état sauvegardé : &lt;i style=&quot;&quot;&gt;Ticket.restaurer()&lt;/i&gt; le crée par &lt;i style=&quot;&quot;&gt;FabriqueEtat.creer(statut)&lt;/i&gt;, sans rejouer les transitions.&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="790" x="900" y="660" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
