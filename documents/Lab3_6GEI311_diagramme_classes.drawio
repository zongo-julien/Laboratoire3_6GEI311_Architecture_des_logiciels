        <mxCell id="p2-SessionEdition" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#6B6B6B&quot;&gt;sessions&lt;/font&gt;&lt;br&gt;&lt;b&gt;SessionEdition&lt;/b&gt;" vertex="1">
