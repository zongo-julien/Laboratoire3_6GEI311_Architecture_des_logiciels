        <mxCell id="p5-l19" connectable="0" parent="p5-e18" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=13;fontColor=#333333;labelBackgroundColor=#FFFFFF;spacing=1;" value="Admin.closeTicket(t)" vertex="1">
